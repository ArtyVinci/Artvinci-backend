# ============================================================================
# DJANGO CONFIGURATION
# ============================================================================
SECRET_KEY=your-secret-key-here-generate-a-strong-one
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# ============================================================================
# DATABASE CONFIGURATION (MongoDB via djongo)
# ============================================================================
MONGO_DB_NAME=artvinci_db
MONGO_URI=mongodb://localhost:27017/artvinci_db

# ============================================================================
# JWT CONFIGURATION
# ============================================================================
# Utilisez la clé fournie ou générez-en une nouvelle sécurisée
JWT_SECRET=

# ============================================================================
# CLOUDINARY CONFIGURATION
# ============================================================================
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=your-api-secret-here

# ============================================================================
# CORS CONFIGURATION
# ============================================================================
# Liste des origines autorisées, séparées par des virgules
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000

# ============================================================================
# EMAIL CONFIGURATION (Placeholders pour étapes futures)
# ============================================================================
# Par défaut, les emails s'affichent dans la console
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=your-email@gmail.com
EMAIL_HOST_PASSWORD=your-email-app-password
EMAIL_FROM=noreply@artvinci.com

# ============================================================================
# NOTES IMPORTANTES
# ============================================================================
# 1. Ne JAMAIS commiter le fichier .env dans Git
# 2. Pour la production, mettre DEBUG=False
# 3. Générer une nouvelle SECRET_KEY pour la production
# 4. Remplacer les valeurs Cloudinary par vos vraies credentials
# 5. Les fonctionnalités email, OTP, Google OAuth et face recognition
#    seront ajoutées dans les prochaines étapes
