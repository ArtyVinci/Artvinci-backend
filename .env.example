# ============================================================================
# PRODUCTION ENVIRONMENT VARIABLES FOR RENDER DEPLOYMENT
# ============================================================================

# Django Core Settings
SECRET_KEY=your-secret-key-here-generate-a-strong-one-for-production
DEBUG=False
ALLOWED_HOSTS=https://your-render-app.onrender.com,https://your-vercel-app.vercel.app

# ============================================================================
# DATABASE CONFIGURATION (MongoDB Atlas for production)
# ============================================================================
MONGO_DB_NAME=artvinci_prod
MONGO_URI=mongodb+srv://username:password@cluster0.xxxxx.mongodb.net/?retryWrites=true&w=majority

# ============================================================================
# JWT CONFIGURATION
# ============================================================================
JWT_SECRET=your-jwt-secret-here-generate-a-secure-one

# ============================================================================
# CLOUDINARY CONFIGURATION (Required for image uploads)
# ============================================================================
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret

# ============================================================================
# FRONTEND CONFIGURATION
# ============================================================================
FRONTEND_URL=https://your-vercel-app.vercel.app

# ============================================================================
# CORS CONFIGURATION
# ============================================================================
CORS_ALLOWED_ORIGINS=https://your-vercel-app.vercel.app,https://your-render-app.onrender.com

# ============================================================================
# EMAIL CONFIGURATION (Optional - can use console backend initially)
# ============================================================================
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=your-email@gmail.com
EMAIL_HOST_PASSWORD=your-app-password
DEFAULT_FROM_EMAIL=your-email@gmail.com

# ============================================================================
# GOOGLE OAUTH CONFIGURATION (Optional)
# ============================================================================
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_CALLBACK_URL=https://your-render-app.onrender.com/auth/google/callback/

# ============================================================================
# AI CONFIGURATION (Required for AI features)
# ============================================================================
GEMINI_API_KEY=your-gemini-api-key

# ============================================================================
# PRODUCTION NOTES
# ============================================================================
# 1. Generate strong SECRET_KEY and JWT_SECRET for production
# 2. Set up MongoDB Atlas cluster and update MONGO_URI
# 3. Configure Cloudinary account for image storage
# 4. Set up Gemini AI API key from Google AI Studio
# 5. Update ALLOWED_HOSTS and CORS_ALLOWED_ORIGINS with actual URLs after deployment
# 6. For email, consider using services like SendGrid, Mailgun, or AWS SES
